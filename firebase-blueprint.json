{
  "entities": {
    "Order": {
      "title": "Order",
      "description": "An ecommerce order from various platforms like Dropi or Shopify",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The user ID of the order owner" },
        "orderId": { "type": "string", "description": "The external order ID" },
        "date": { "type": "string", "format": "date-time", "description": "Date of the order" },
        "product": { "type": "string" },
        "cost": { "type": "number" },
        "price": { "type": "number" },
        "shippingCharged": { "type": "number" },
        "shippingReal": { "type": "number" },
        "adsCost": { "type": "number" },
        "platformFee": { "type": "number" },
        "status": { "type": "string", "enum": ["Entregado", "En tránsito", "Devuelto", "Cancelado", "Pendiente", "Guía Generada", "Recolectado", "Incidencia"] },
        "provider": { "type": "string" },
        "country": { "type": "string" },
        "trackingId": { "type": "string" },
        "cancellationReason": { "type": "string" },
        "nombreCliente": { "type": "string" },
        "telefono": { "type": "string" },
        "emailCliente": { "type": "string" },
        "ciudadDestino": { "type": "string" },
        "departamentoDestino": { "type": "string" },
        "direccion": { "type": "string" },
        "transportadora": { "type": "string" },
        "numeroFactura": { "type": "string" },
        "valorFacturado": { "type": "number" },
        "valorCompraProductos": { "type": "number" },
        "gananciaManual": { "type": "number" },
        "precioFlete": { "type": "number" },
        "costoDevolucionFlete": { "type": "number" },
        "comision": { "type": "number" },
        "totalPreciosProveedor": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "orderId", "date", "status"]
    },
    "SavedProduct": {
      "title": "Saved Product Calculation",
      "description": "A saved calculation for a product's profitability",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "url": { "type": "string" },
        "notes": { "type": "string" },
        "currency": { "type": "string" },
        "inputs": { "type": "object" },
        "results": { "type": "object" },
        "timestamp": { "type": "number" }
      },
      "required": ["uid", "name", "timestamp"]
    },
    "SalePeriod": {
      "title": "Sale Period",
      "description": "Information about a sales period for Guatemaldropi",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "month": { "type": "string" },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "withdrawalDropi": { "type": "number" },
        "withdrawalBankName": { "type": "string" },
        "commission": { "type": "number" },
        "withdrawalBank": { "type": "number" },
        "adsSpend": { "type": "number" },
        "platformExpenses": { "type": "number" },
        "shopifyOrders": { "type": "number", "description": "Number of orders entered in Shopify" },
        "cancelledOrders": { "type": "number", "description": "Number of cancelled orders" },
        "dropiOrders": { "type": "number", "description": "Number of orders uploaded to Dropi" },
        "tiktokOrders": { "type": "number", "description": "Number of TikTok orders" },
        "dropiCancelled": { "type": "number", "description": "Number of orders cancelled in Dropi" },
        "returnedOrders": { "type": "number", "description": "Number of returned orders" },
        "tags": { "type": "string", "description": "Tags for filtering periods" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "month", "startDate", "endDate"]
    },
    "MarketResearchItem": {
      "title": "Market Research Item",
      "description": "Details about a market research analysis for a product.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "productName": { "type": "string" },
        "storeUrls": { 
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": "string" },
        "videoUrls": { 
          "type": "array",
          "items": { "type": "string" }
        },
        "timestamp": { "type": "number" }
      },
      "required": ["uid", "productName", "timestamp"]
    },
    "AdExpense": {
      "title": "Advertising Expense",
      "description": "An isolated advertising investment record per product and platform",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "accountName": { "type": "string" },
        "platform": { "type": "string" },
        "amount": { "type": "number" },
        "originalAmount": { "type": "number" },
        "originalCurrency": { "type": "string" },
        "conversionRate": { "type": "number" },
        "timestamp": { "type": "number" },
        "notes": { "type": "string" },
        "color": { "type": "string" }
      },
      "required": ["uid", "productId", "date", "platform", "amount", "timestamp"]
    },
    "FinancialReport": {
      "title": "Financial Report",
      "description": "A financial report with uploaded files and notes",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "notes": { "type": "string" },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "url": { "type": "string" },
              "type": { "type": "string" },
              "size": { "type": "number" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "title", "date", "files", "createdAt"]
    },
    "ReturnNovelty": {
      "title": "Return Novelty Log",
      "description": "Log records for returned orders, incidents and novelties arisen during transit/return",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "orderId": { "type": "string" },
        "productName": { "type": "string" },
        "nombreCliente": { "type": "string" },
        "fecha": { "type": "string", "format": "date" },
        "origenNovedad": { "type": "string" },
        "descripcion": { "type": "string" },
        "resolucion": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["uid", "fecha", "origenNovedad", "descripcion", "timestamp"]
    },
    "FinancialOverride": {
      "title": "Financial Override",
      "description": "Customized financial report values per month to override default calculations",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "monthKey": { "type": "string", "description": "Format: YYYY-MM" },
        "revenue": { "type": "number" },
        "cogs": { "type": "number" },
        "shipping": { "type": "number" },
        "ads": { "type": "number" },
        "fees": { "type": "number" },
        "returnsLoss": { "type": "number" },
        "otherExpenses": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["uid", "monthKey", "revenue", "cogs", "shipping", "ads", "fees", "returnsLoss"]
    },
    "CustomReturnTags": {
      "title": "Custom Return Tags",
      "description": "User custom labels and color palette for returns",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "labels": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "colorId": { "type": "string" }
            },
            "required": ["name", "colorId"]
          }
        }
      },
      "required": ["uid", "labels"]
    },
    "OtherPlatformExpense": {
      "title": "Other Platform Expense",
      "description": "Subscription, software, salaries, or other fixed operational expenses for a month",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "amount": { "type": "number" },
        "originalAmount": { "type": "number" },
        "originalCurrency": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "timestamp": { "type": "number" }
      },
      "required": ["uid", "name", "category", "amount", "date", "timestamp"]
    },
    "AdPanelLog": {
      "title": "Ad Panel Log",
      "description": "Daily advertisement log tracking spend, sales, CPA, month and product type",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "month": { "type": "string" },
        "platform": { "type": "string" },
        "campaignType": { "type": "string", "enum": ["whatsapp", "landing"] },
        "spend": { "type": "number" },
        "salesCount": { "type": "number" },
        "adId": { "type": "string" },
        "productName": { "type": "string" },
        "productSource": { "type": "string" },
        "targetCpa": { "type": "number" },
        "notes": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["uid", "date", "month", "platform", "campaignType", "spend", "salesCount"]
    }
  },
  "firestore": {
    "orders/{orderId}": {
      "schema": "Order",
      "description": "Collection of orders associated with users"
    },
    "savedProducts/{productId}": {
      "schema": "SavedProduct",
      "description": "Collection of saved product calculations"
    },
    "salePeriods/{periodId}": {
      "schema": "SalePeriod",
      "description": "Collection of sales periods for tracking profit and withdrawals"
    },
    "ad_expenses/{expenseId}": {
      "schema": "AdExpense",
      "description": "Collection of advertising expenses"
    },
    "market_research/{researchId}": {
      "schema": "MarketResearchItem",
      "description": "Collection of market research and product analysis"
    },
    "financialReports/{reportId}": {
      "schema": "FinancialReport",
      "description": "Collection of financial reports and uploaded documents"
    },
    "return_novelties/{noveltyId}": {
      "schema": "ReturnNovelty",
      "description": "Log records for incidents, return novelties, dates, edit and delete actions"
    },
    "financialOverrides/{overrideId}": {
      "schema": "FinancialOverride",
      "description": "Collection of customized finance ratios and overrides per month"
    },
    "custom_return_tags/{tagId}": {
      "schema": "CustomReturnTags",
      "description": "Collection of custom return labels and color assignments"
    },
    "other_platform_expenses/{expenseId}": {
      "schema": "OtherPlatformExpense",
      "description": "Collection of other platform and operational expenses"
    },
    "ad_panel_logs/{logId}": {
      "schema": "AdPanelLog",
      "description": "Collection of daily advertising logs from the Ad Panel"
    }
  }
}
