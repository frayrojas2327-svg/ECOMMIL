rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isVerified() {
      return isSignedIn(); // Relaxed for demo/dev to unblock users with unverified emails
    }
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'client') == 'admin';
    }

    // Helper for Orders
    function isValidOrder(data) {
      return data.get('uid', '') == request.auth.uid &&
             data.orderId is string && data.orderId.size() <= 100 &&
             data.status in ['Entregado', 'En tránsito', 'Devuelto', 'Cancelado', 'Pendiente', 'Guía Generada', 'Recolectado', 'Incidencia'] &&
             (data.get('price', 0) is number) &&
             (data.get('cost', 0) is number);
    }

    // Helper for Ad Expenses
    function isValidAdExpense(data) {
      return data.get('uid', '') == request.auth.uid &&
             data.get('productId', '') is string &&
             data.date is string && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
             data.get('platform', '') is string &&
             data.amount is number &&
             data.timestamp is number;
    }

    // Helper for Market Research
    function isValidMarketResearch(data) {
      return data.get('uid', '') == request.auth.uid &&
             data.get('productName', '') is string &&
             data.timestamp is number;
    }

    // Helper for Sale Periods
    function isValidSalePeriod(data) {
      return data.get('uid', '') == request.auth.uid &&
             data.month is string && data.month.size() <= 60 &&
             data.get('startDate', '') is string &&
             data.get('endDate', '') is string;
    }

    // Helper for Financial Reports
    function isValidFinancialReport(data) {
      return data.get('uid', '') == request.auth.uid &&
             data.title is string && data.title.size() <= 200 &&
             data.date is string && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
             data.get('category', 'Otros') is string &&
             data.get('notes', '') is string &&
             data.files is list && data.files.size() <= 100;
    }

    // Helper for Return Novelties
    function isValidReturnNovelty(data) {
      return data.get('uid', '') == request.auth.uid &&
             data.fecha is string && data.fecha.size() <= 60 &&
             data.get('origenNovedad', '') is string && data.get('origenNovedad', '').size() <= 250 &&
             data.get('descripcion', '') is string && data.get('descripcion', '').size() <= 2000 &&
             data.timestamp is number;
    }

    // Helper for Financial Overrides
    function isValidFinancialOverride(data) {
      return data.get('uid', '') == request.auth.uid &&
             data.monthKey is string && data.monthKey.matches('^\\d{4}-\\d{2}$') &&
             data.revenue is number &&
             data.cogs is number &&
             data.shipping is number &&
             data.ads is number &&
             data.fees is number &&
             data.returnsLoss is number;
    }

    // 1. Orders Collection
    match /orders/{orderId} {
      allow get: if isOwner(resource.data.get('uid', ''));
      allow list: if isSignedIn() && resource.data.get('uid', '') == request.auth.uid;
      
      allow create: if isVerified() && 
                      isValidId(orderId) &&
                      isValidOrder(incoming()) &&
                      incoming().keys().hasAll(['uid', 'orderId', 'date', 'status']);
      
      allow update: if isVerified() &&
                       isOwner(resource.data.get('uid', '')) &&
                       isValidOrder(incoming()) &&
                       incoming().get('uid', '') == resource.data.get('uid', '') &&
                       incoming().orderId == resource.data.get('orderId', '');
      
      allow delete: if (isOwner(resource.data.get('uid', '')) && isVerified()) || isAdmin();
    }

    // 2. Saved Products Collection
    match /savedProducts/{productId} {
      allow get: if isOwner(resource.data.get('uid', ''));
      allow list: if isSignedIn() && resource.data.get('uid', '') == request.auth.uid;
      allow create, update: if isVerified() && 
                             isValidId(productId) &&
                             incoming().get('uid', '') == request.auth.uid;
      allow delete: if (isOwner(resource.data.get('uid', '')) && isVerified()) || isAdmin();
    }

    // 3. Sale Periods Collection
    match /salePeriods/{periodId} {
      allow get: if isOwner(resource.data.get('uid', ''));
      allow list: if isSignedIn() && resource.data.get('uid', '') == request.auth.uid;
      
      allow create: if isVerified() &&
                      isValidId(periodId) &&
                      isValidSalePeriod(incoming());
      
      allow update: if isVerified() &&
                       isOwner(resource.data.get('uid', '')) &&
                       isValidSalePeriod(incoming()) &&
                       incoming().get('uid', '') == resource.data.get('uid', '');
                        
      allow delete: if (isOwner(resource.data.get('uid', '')) && isVerified()) || isAdmin();
    }

    // 4. Ad Expenses Collection
    match /ad_expenses/{expenseId} {
      allow get: if isOwner(resource.data.get('uid', ''));
      allow list: if isSignedIn() && resource.data.get('uid', '') == request.auth.uid;
      allow create: if isVerified() && 
                      isValidId(expenseId) &&
                      isValidAdExpense(incoming());
      allow update: if isVerified() &&
                       isOwner(resource.data.get('uid', '')) &&
                       isValidAdExpense(incoming()) &&
                       incoming().get('uid', '') == resource.data.get('uid', '');
      allow delete: if isVerified() && isOwner(resource.data.get('uid', ''));
    }

    // 5. Market Research Collection
    match /market_research/{researchId} {
      allow get: if isOwner(resource.data.get('uid', ''));
      allow list: if isSignedIn() && resource.data.get('uid', '') == request.auth.uid;
      allow create: if isVerified() && 
                      isValidId(researchId) &&
                      isValidMarketResearch(incoming());
      allow update: if isVerified() &&
                       isOwner(resource.data.get('uid', '')) &&
                       isValidMarketResearch(incoming()) &&
                       incoming().get('uid', '') == resource.data.get('uid', '');
      allow delete: if isVerified() && isOwner(resource.data.get('uid', ''));
    }

    // 6. Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && 
                      incoming().role == 'client' && 
                      incoming().keys().hasAll(['uid', 'email', 'role']);
      allow update: if isOwner(userId) && 
                      incoming().role == existing().role && // Prevent self-elevation
                      incoming().email == existing().email;
    }

    // 7. Financial Reports Collection
    match /financialReports/{reportId} {
      allow get: if isOwner(resource.data.get('uid', ''));
      allow list: if isSignedIn() && resource.data.get('uid', '') == request.auth.uid;
      
      allow create: if isVerified() &&
                      isValidId(reportId) &&
                      isValidFinancialReport(incoming()) &&
                      incoming().createdAt == request.time;
      
      allow update: if isVerified() &&
                       isOwner(resource.data.get('uid', '')) &&
                       isValidFinancialReport(incoming()) &&
                       incoming().uid == resource.data.uid &&
                       incoming().get('createdAt', request.time) == existing().createdAt;
      
      allow delete: if isOwner(resource.data.get('uid', '')) || isAdmin();
    }

    // 8. Return Novelties Collection
    match /return_novelties/{noveltyId} {
      allow get: if isOwner(resource.data.get('uid', ''));
      allow list: if isSignedIn() && resource.data.get('uid', '') == request.auth.uid;
      
      allow create: if isVerified() && 
                      isValidId(noveltyId) &&
                      isValidReturnNovelty(incoming());
      
      allow update: if isVerified() &&
                       isOwner(resource.data.get('uid', '')) &&
                       isValidReturnNovelty(incoming()) &&
                       incoming().get('uid', '') == resource.data.get('uid', '');
                       
      allow delete: if isVerified() && isOwner(resource.data.get('uid', ''));
    }

    // 9. Financial Overrides Collection
    match /financialOverrides/{overrideId} {
      allow get: if isOwner(resource.data.get('uid', ''));
      allow list: if isSignedIn() && resource.data.get('uid', '') == request.auth.uid;
      
      allow create: if isVerified() && 
                      isValidId(overrideId) &&
                      isValidFinancialOverride(incoming());
      
      allow update: if isVerified() &&
                       isOwner(resource.data.get('uid', '')) &&
                       isValidFinancialOverride(incoming()) &&
                       incoming().get('uid', '') == resource.data.get('uid', '');
                       
      allow delete: if isVerified() && isOwner(resource.data.get('uid', ''));
    }
  }
}
